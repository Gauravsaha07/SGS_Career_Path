# Server Port
PORT=5511

# MongoDB Connection String
DATABASE_URI=mongodb://localhost:27017/SGS-NEXT-STEP

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_here

# Allowed Client Origin for CORS and Socket.io
CLIENT_URL=http://localhost:5173

# Cloudinary Configuration for Image Uploads
# Either provide CLOUDINARY_URL (recommended, full connection string including cloud_name, api_key, api_secret)
# Or provide the individual variables: CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
CLOUDINARY_URL=cloudinary://your_key:your_secret@cloud_name
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini API Key and Model for AI Roadmap and Admin Assistant
GEMINI_API_KEY=your_gemini_api_key
# Recommended: gemini-3.5-flash (default fallback), gemini-1.5-flash, or gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-flash
